{
  "name": "tss-insurance-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && tsc --project tsconfig.server.json --noEmit",
    "build": "npm run assets && astro build && node scripts/build-worker.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "node --import tsx scripts/verify-build.mjs"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "@tabler/icons": "^3.35.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
