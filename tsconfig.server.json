{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["middleware.ts", "api/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "src/data/services.ts", "src/lib/validation.ts"]
}
