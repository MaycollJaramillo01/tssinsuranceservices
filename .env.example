# Build settings. Keep review noindex until the business approves publication.
# Optional on Vercel: falls back to the project's production domain when empty.
# Set the final custom domain explicitly before launching on other hosts.
SITE_URL=
PUBLIC_INDEXABLE=false
# Server-only runtime values. All five are required before the form activates.
RESEND_API_KEY=
MAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
