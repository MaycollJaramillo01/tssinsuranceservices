---
import { team } from '../data/team';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
interface Props { heading?: boolean; }
const { heading = true } = Astro.props;
---
<section class="section team-section" aria-label="The TSS team"><div class="container">
  {heading && <div class="section-heading"><h2>Meet the people behind TSS</h2><p>Get to know the people you can talk to about your next step.</p></div>}
  <div class="team-grid">{team.map(person => <article class="team-profile"><Photo name={person.image} alt={person.alt} /><div class="team-profile__heading"><h3>{person.name}</h3><p class="team-role">{person.role}</p></div><p>{person.bio}</p></article>)}</div>
  {heading && <div class="section-end"><a class="text-link" href="/our-team/">More about our team<Icon name="arrow-right" /></a></div>}
</div></section>
