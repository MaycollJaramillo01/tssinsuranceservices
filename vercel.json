{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:client",
  "outputDirectory": "build/client",
  "trailingSlash": true,
  "proxy": {
    "entrypoint": "middleware.ts",
    "matcher": "/((?!_astro/|images/|fonts/|licenses/|_vercel/|\\.well-known/|maintenance\\.css|robots\\.txt|sitemap.*\\.xml).*)"
  },
  "functions": { "api/*.ts": { "maxDuration": 30 } },
  "redirects": [
    { "source": "/insurance-2", "destination": "/insurance/", "statusCode": 301 },
    { "source": "/insurance-2/", "destination": "/insurance/", "statusCode": 301 },
    { "source": "/income-tax-2", "destination": "/income-tax/", "statusCode": 301 },
    { "source": "/income-tax-2/", "destination": "/income-tax/", "statusCode": 301 },
    { "source": "/contact-8", "destination": "/contact/", "statusCode": 301 },
    { "source": "/contact-8/", "destination": "/contact/", "statusCode": 301 },
    { "source": "/insurance", "destination": "/insurance/", "statusCode": 301 },
    { "source": "/income-tax", "destination": "/income-tax/", "statusCode": 301 },
    { "source": "/dmv-services", "destination": "/dmv-services/", "statusCode": 301 },
    { "source": "/real-estate-mortgage", "destination": "/real-estate-mortgage/", "statusCode": 301 },
    { "source": "/business-formation", "destination": "/business-formation/", "statusCode": 301 },
    { "source": "/our-team", "destination": "/our-team/", "statusCode": 301 },
    { "source": "/contact", "destination": "/contact/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
